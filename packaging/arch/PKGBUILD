# Maintainer: Arctic Latent
pkgname=arctic-comfyui-helper
pkgver=0.2.8
pkgrel=1
pkgdesc='ComfyUI installer and model manager'
arch=('x86_64')
url='https://github.com/ArcticLatent/Arctic-Helper'
license=('Apache-2.0')
options=('!buildflags' '!debug')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'libayatana-appindicator'
  'xdg-desktop-portal-gtk'
  'dbus'
)
makedepends=(
  'binutils'
  'cargo'
  'gcc'
  'rust'
  'pkgconf'
)
source=()
sha256sums=()

prepare() {
  cd "$startdir/../.."
}

build() {
  cd "$startdir/../.."

  # A leaked NIX_LDFLAGS (or a compiler wrapper from a Nix development shell)
  # can make a successful-looking Arch build whose ELF interpreter and RUNPATH
  # point into /nix/store. Use only the native Arch toolchain and pkg-config
  # paths for this package build.
  unset "${!NIX_@}"
  unset \
    CARGO_BUILD_RUSTC_WRAPPER \
    CMAKE_PREFIX_PATH \
    CPATH \
    CPLUS_INCLUDE_PATH \
    C_INCLUDE_PATH \
    LD_LIBRARY_PATH \
    LIBRARY_PATH \
    PKG_CONFIG_LIBDIR \
    PKG_CONFIG_PATH \
    RUSTC_WRAPPER
  export PATH='/usr/bin:/bin'
  export CC='/usr/bin/gcc'
  export CXX='/usr/bin/g++'
  export CARGO_TARGET_DIR="$srcdir/target"
  export RUSTFLAGS="-C link-arg=-fuse-ld=bfd"
  cargo build --release --manifest-path src-tauri/Cargo.toml
}

check() {
  cd "$startdir/../.."
  export CARGO_TARGET_DIR="$srcdir/target"

  bash scripts/verify-linux-elf.sh \
    "$CARGO_TARGET_DIR/release/Arctic-ComfyUI-Helper" \
    '/lib64/ld-linux-x86-64.so.2'
}

package() {
  cd "$startdir/../.."
  export CARGO_TARGET_DIR="$srcdir/target"

  install -Dm755 "$CARGO_TARGET_DIR/release/Arctic-ComfyUI-Helper" \
    "$pkgdir/usr/bin/arctic-comfyui-helper"

  install -Dm644 packaging/linux/io.github.ArcticHelper.desktop \
    "$pkgdir/usr/share/applications/io.github.ArcticHelper.desktop"

  install -Dm644 src-tauri/dist/icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.ArcticHelper.svg"

  install -Dm644 README.public.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
