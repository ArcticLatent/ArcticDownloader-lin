{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arctic ComfyUI Helper",
  "version": "0.2.9",
  "identifier": "io.github.ArcticHelper",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Arctic ComfyUI Helper",
        "width": 1240,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https: http:; media-src 'self' https: http:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Arctic Latent",
    "linux": {
      "deb": {
        "depends": [
          "libcanberra-gtk3-module"
        ]
      }
    },
    "icon": [
      "icons/icon-32.png",
      "icons/icon-64.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
